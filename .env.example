# Copy to .env.local and fill in. See README → "Google sign-in setup".

# Encrypts the session cookie (holds the Google refresh token). Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Production only, when not on Vercel: trust the Host header (or set AUTH_URL=https://your.domain).
# AUTH_TRUST_HOST=true
