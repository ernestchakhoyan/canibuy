{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@action": ["./src/action"],
      "@action/*": ["./src/action/*"],
      "@builder": ["./src/builder"],
      "@builder/*": ["./src/builder/*"],
      "@container": ["./src/container"],
      "@container/*": ["./src/container/*"],
      "@helper": ["./src/helper"],
      "@i18n": ["./src/i18n"],
      "@i18n/*": ["./src/i18n/*"],
      "@helper/*": ["./src/helper/*"],
      "@layout": ["./src/layout"],
      "@layout/*": ["./src/layout/*"],
      "@server": ["./src/server"],
      "@server/*": ["./src/server/*"],
      "@store": ["./src/store"],
      "@store/*": ["./src/store/*"],
      "@type": ["./src/@type"],
      "@type/*": ["./src/@type/*"],
      "@widget": ["./src/widget"],
      "@widget/*": ["./src/widget/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts", "**/*.mts"],
  "exclude": ["node_modules"]
}
